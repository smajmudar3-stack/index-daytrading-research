# Copy to .env and fill in what you have. None are required to render the
# dashboard; each one switches on a panel that otherwise reads "unavailable".
# .env is gitignored. Never commit a real key.

# Desk analyst, the trading agent, the committee, and the lessons loop.
ANTHROPIC_API_KEY=

# Same-day dealer gamma, flow lean, max pain. Without it the 0DTE panels fall
# back to the SqueezeMetrics prior-close baseline. A LAPSED subscription is not
# the same as a missing key: uw_client trips itself after repeated 401s.
UNUSUALWHALES_API_KEY=

# Minute bars for 05_studies. Free tier is reference data only — no historical
# option or equity aggregates.
POLYGON_API_KEY=

# Optional. Point at an existing 16 GB market-data directory (06_data_guide/DATA.md).
# IDT_DATA_ROOT=/path/to/index-daytrading/data
